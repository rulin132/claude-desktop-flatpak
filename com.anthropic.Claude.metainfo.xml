<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>com.anthropic.Claude</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <name>Claude</name>
  <summary>AI assistant from Anthropic</summary>
  <description>
    <p>
      Claude is an AI assistant created by Anthropic. This desktop application
      provides a native interface to interact with Claude, offering features like:
    </p>
    <ul>
      <li>Natural language conversations</li>
      <li>Code generation and analysis</li>
      <li>Document processing and analysis</li>
      <li>File system integration via MCP servers</li>
      <li>Desktop Commander for system interaction</li>
    </ul>
  </description>
  <launchable type="desktop-id">com.anthropic.Claude.desktop</launchable>
  <url type="homepage">https://claude.ai</url>
  <url type="help">https://support.claude.com</url>
  <url type="bugtracker">https://github.com/rulin132/claude-desktop-flatpak/issues</url>
  <url type="vcs-browser">https://github.com/rulin132/claude-desktop-flatpak</url>
  <developer id="com.anthropic">
    <name>Anthropic</name>
  </developer>
  <content_rating type="oars-1.1"/>

  <!--
    Screenshots are required before this can be submitted to any software
    centre (Flathub, and therefore Bazaar). See DISTRIBUTION.md.

    <screenshots>
      <screenshot type="default">
        <image>https://.../claude-main-window.png</image>
        <caption>Chatting with Claude</caption>
      </screenshot>
    </screenshots>
  -->

  <!--
    Versions here are *packaging* versions and must match the git tag and the
    CHANGELOG.md heading. The packaged Claude Desktop version is named in each
    release description. scripts/check-version.sh enforces this.
  -->
  <releases>
    <release version="1.1.0" date="2024-11-02">
      <url>https://github.com/rulin132/claude-desktop-flatpak/releases/tag/v1.1.0</url>
      <description>
        <p>Packaging release for Claude Desktop 0.14.10.</p>
        <ul>
          <li>Native window decorations and window dragging on Wayland</li>
          <li>Bundled Electron 32.2.0 so the package is self-contained</li>
          <li>Fixed SUID sandbox configuration errors</li>
        </ul>
      </description>
    </release>
    <release version="1.0.0" date="2024-11-02">
      <url>https://github.com/rulin132/claude-desktop-flatpak/releases/tag/v1.0.0</url>
      <description>
        <p>First Flatpak package for Claude Desktop 0.14.10.</p>
      </description>
    </release>
  </releases>
</component>
